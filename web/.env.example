# Vite dev server proxy target for /auth, /v1, and /browser (vite.config.ts only).
# Not exposed to client bundles via import.meta.env.

# Docker authenticated-browser profile (pnpm compose:candidate):
VITE_DEV_API_PROXY=http://127.0.0.1:18080

# Bare dotnet API (dotnet run --project src/Hosts/FlexAgent.Api):
# VITE_DEV_API_PROXY=http://localhost:8080
