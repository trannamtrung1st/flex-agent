{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "vite.config.ts", "vite.design-lab.config.ts", "vitest.design-lab.config.ts", "playwright.design-lab.config.ts", "eslint.config.js", "vitest.setup.ts"],
  "exclude": ["src/design-lab", "e2e", "dist", "dist-design-lab"]
}
