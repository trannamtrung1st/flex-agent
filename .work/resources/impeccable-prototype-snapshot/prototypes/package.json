{
  "name": "flex-agent-prototypes",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
