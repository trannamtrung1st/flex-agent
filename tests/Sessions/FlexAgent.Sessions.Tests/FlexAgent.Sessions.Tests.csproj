<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlexAgent.Sessions.Tests</RootNamespace>
    <AssemblyName>FlexAgent.Sessions.Tests</AssemblyName>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\contracts\fixtures\schema\v2\session\agent-decision\**\*"
             Link="contracts\fixtures\schema\v2\session\agent-decision\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\contracts\fixtures\schema\v1\session\command-envelope\**\*"
             Link="contracts\fixtures\schema\v1\session\command-envelope\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Sessions\FlexAgent.Sessions\FlexAgent.Sessions.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Sessions\FlexAgent.Sessions.Infrastructure\FlexAgent.Sessions.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlexAgent.Sessions.OpenAiCompatible.Tests" />
    <InternalsVisibleTo Include="FlexAgent.Sessions.OpenRouter.Tests" />
  </ItemGroup>

</Project>
