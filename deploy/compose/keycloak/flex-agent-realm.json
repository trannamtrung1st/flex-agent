{
  "realm": "flex-agent",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "clients": [
    {
      "clientId": "flex-agent-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:18080/auth/callback",
        "http://localhost:5274/auth/callback"
      ],
      "adminUrl": "http://api:8080",
      "rootUrl": "http://api:8080",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://api:8080/auth/backchannel-logout",
        "backchannel.logout.session.required": "false"
      },
      "protocolMappers": [
        {
          "name": "acr-mfa-synthetic-accepted-strength",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "acr",
            "claim.value": "acr:mfa",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "amr-mfa-synthetic-accepted-strength",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "amr",
            "claim.value": "[\"mfa\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "dddddddd-dddd-4ddd-8ddd-dddddddddddd",
