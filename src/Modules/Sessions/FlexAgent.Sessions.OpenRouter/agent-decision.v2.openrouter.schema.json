{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/session/agent-decision.v2.openrouter.schema.json",
  "title": "Agent Decision envelope v2 OpenRouter transport projection",
  "description": "Self-contained transport projection of the canonical v2 Agent Decision schema. Known voice, timer, and deferred-action shapes remain representable so P0 policy can reject them independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_decision_id",
    "agent_invocation_id",
    "produced_at",
    "disposition",
    "outputs",
    "requested_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "v2"
    },
    "agent_decision_id": {
      "$ref": "#/$defs/stable_id"
    },
    "agent_invocation_id": {
      "$ref": "#/$defs/stable_id"
    },
    "produced_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "respond",
        "no_action"
      ]
    },
    "outputs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/output_recommendation"
      }
    },
    "requested_actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/requested_action"
      }
    },
    "no_action": {
      "$ref": "#/$defs/no_action_payload"
    },
    "payload_ref": {
      "$ref": "#/$defs/protected_reference"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "no_action"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "required": [
          "no_action"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "respond"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "not": {
          "required": [
            "no_action"
          ]
        }
      }
    }
  ],
  "$defs": {
    "no_action_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_category"
      ],
      "properties": {
        "reason_category": {
          "type": "string",
          "enum": [
            "intentional_silence",
            "workflow_complete",
            "awaiting_input"
          ]
        }
      }
    },
    "local_ref": {
      "$ref": "#/$defs/stable_id"
    },
    "audience": {
      "type": "string",
      "enum": [
        "participant",
        "reviewer",
        "administrator",
        "runtime_only"
      ]
    },
    "output_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "local_ref"
      ],
      "properties": {
        "relation": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "local_ref": {
          "$ref": "#/$defs/local_ref"
        }
      }
    },
    "output_recommendation": {
      "oneOf": [
        {
          "$ref": "#/$defs/message_output"
        },
        {
          "$ref": "#/$defs/voice_output"
        }
      ]
    },
    "message_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "local_ref",
        "communication_purpose"
      ],
      "properties": {
        "kind": {
          "const": "message"
        },
        "local_ref": {
          "$ref": "#/$defs/local_ref"
        },
        "communication_purpose": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        },
        "turn_id": {
          "$ref": "#/$defs/stable_id"
        },
        "response_slot_id": {
          "$ref": "#/$defs/stable_id"
        },
        "agent_output_id": {
          "$ref": "#/$defs/stable_id"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "references": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/output_reference"
          }
        }
      }
    },
    "voice_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "local_ref"
      ],
      "properties": {
        "kind": {
          "const": "voice"
        },
        "local_ref": {
          "$ref": "#/$defs/local_ref"
        },
        "agent_output_id": {
          "$ref": "#/$defs/stable_id"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "references": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/output_reference"
          }
        },
        "payload_ref": {
          "$ref": "#/$defs/protected_reference"
        }
      }
    },
    "requested_action": {
      "oneOf": [
        {
          "$ref": "#/$defs/next_timer_action"
        },
        {
          "$ref": "#/$defs/deferred_action"
        }
      ]
    },
    "next_timer_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "local_ref",
        "relative_delay",
        "expected_schedule_revision"
      ],
      "properties": {
        "kind": {
          "const": "next_timer_request"
        },
        "local_ref": {
          "$ref": "#/$defs/local_ref"
        },
        "relative_delay": {
          "$ref": "#/$defs/iso8601_positive_duration"
        },
        "expected_schedule_revision": {
          "$ref": "#/$defs/positive_int64_wire_string"
        }
      }
    },
    "deferred_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "local_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "request_tool",
            "propose_transition",
            "escalate"
          ]
        },
        "local_ref": {
          "$ref": "#/$defs/local_ref"
        }
      }
    },
    "int64_wire_string_nineteen_digit": {
      "type": "string",
      "minLength": 19,
      "maxLength": 19,
      "pattern": "^(922337203685477580[0-7]|92233720368547758[0-6][0-9]|9223372036854775[0-7][0-9]{2}|922337203685477[0-4][0-9]{3}|92233720368547[0-5][0-9]{4}|9223372036854[0-6][0-9]{5}|922337203685[0-3][0-9]{6}|92233720368[0-4][0-9]{7}|9223372036[0-7][0-9]{8}|922337203[0-5][0-9]{9}|92233720[0-2][0-9]{10}|9223372[0-0][0-9]{11}|922337[0-1][0-9]{12}|92233[0-6][0-9]{13}|9223[0-2][0-9]{14}|922[0-2][0-9]{15}|92[0-1][0-9]{16}|9[0-1][0-9]{17}|[1-8][0-9]{18})$"
    },
    "iso8601_positive_duration": {
      "type": "string",
      "description": "Positive ISO 8601 duration without year/month/week or fractional seconds. Wire shape is validated here; total active seconds must fall within PT1S..PT24H via semantic contract tests.",
      "minLength": 4,
      "maxLength": 16,
      "oneOf": [
        {
          "pattern": "^PT(?:[1-9]|[1-5][0-9])S$"
        },
        {
          "pattern": "^PT(?:[1-9]|[1-5][0-9])M$"
        },
        {
          "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H$"
        },
        {
          "pattern": "^PT24H$"
        },
        {
          "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H(?:[1-9]|[1-5][0-9])M$"
        },
        {
          "pattern": "^PT(?:[1-9]|[1-5][0-9])M(?:[1-9]|[1-5][0-9])S$"
        },
        {
          "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H(?:[1-9]|[1-5][0-9])S$"
        },
        {
          "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H(?:[1-9]|[1-5][0-9])M(?:[1-9]|[1-5][0-9])S$"
        }
      ]
    },
    "positive_int64_wire_string": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[1-9]$"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{1,16}$",
          "minLength": 2,
          "maxLength": 17
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{17}$",
          "minLength": 18,
          "maxLength": 18
        },
        {
          "$ref": "#/$defs/int64_wire_string_nineteen_digit"
        }
      ]
    },
    "protected_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_ref",
        "content_digest"
      ],
      "properties": {
        "protected_ref": {
          "$ref": "#/$defs/stable_id"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stable_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{7,127}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "maxLength": 32
    }
  }
}
