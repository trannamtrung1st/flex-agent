{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--isolated",
        "--output-dir",
        "${workspaceFolder}/.playwright-mcp",
        "--output-mode",
        "file"
      ]
    }
  }
}
