{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/submission/intake-mutation-outcome.v2.schema.json",
  "title": "Intake mutation outcome v2",
  "description": "Server-derived intake begin, item receipt, cancel, or finalize outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "succeeded", "outcome_code", "permitted_actions"],
  "properties": {
    "schema_version": { "const": "v2" },
    "succeeded": { "type": "boolean" },
    "outcome_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._]{0,127}$"
    },
    "intake_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "submission_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": ["string", "null"],
      "enum": ["receiving", "received", "validating", "cancelling", "cancelled", "rejected", "failed", "reconciling", "accepted", null]
    },
    "revision": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 2147483647
    },
    "version_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version_number": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 2147483647
    },
    "permitted_actions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "begin_intake",
          "complete_item",
          "cancel_intake",
          "finalize_intake",
          "preview_item",
          "download_item",
          "return_to_my_work"
        ]
      }
    }
  }
}
