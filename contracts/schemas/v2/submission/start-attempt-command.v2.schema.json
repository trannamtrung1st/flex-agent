{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/submission/start-attempt-command.v2.schema.json",
  "title": "Start Attempt command v2",
  "description": "Idempotent participant command that starts or reconciles one Attempt from My Work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "trusted_command_digest"],
  "properties": {
    "schema_version": { "const": "v2" },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "trusted_command_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
