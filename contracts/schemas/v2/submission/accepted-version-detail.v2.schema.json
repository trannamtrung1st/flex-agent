{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/submission/accepted-version-detail.v2.schema.json",
  "title": "Accepted submission version detail v2",
  "description": "Exact accepted-version metadata and authorized item list for one Participant Assignment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version_id",
    "version_number",
    "accepted_at_utc",
    "items",
    "permitted_actions"
  ],
  "properties": {
    "schema_version": { "const": "v2" },
    "version_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "accepted_at_utc": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
    },
    "items": {
      "type": "array",
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "category",
          "byte_count",
          "preview_authorized",
          "download_authorized"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "category": {
            "type": "string",
            "enum": ["direct_text", "text_plain_attachment", "text_markdown_attachment"]
          },
          "filename": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 200
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10485760
          },
          "preview_authorized": { "type": "boolean" },
          "download_authorized": { "type": "boolean" }
        }
      }
    },
    "permitted_actions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "begin_intake",
          "complete_item",
          "cancel_intake",
          "finalize_intake",
          "preview_item",
          "download_item",
          "return_to_my_work"
        ]
      }
    }
  }
}
