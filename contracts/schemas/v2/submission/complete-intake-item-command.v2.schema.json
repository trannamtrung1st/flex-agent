{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/submission/complete-intake-item-command.v2.schema.json",
  "title": "Complete intake item command v2",
  "description": "Participant command that records complete server receipt of one direct-text or UTF-8 attachment item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "category",
    "content",
    "expected_revision",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": { "const": "v2" },
    "category": {
      "type": "string",
      "enum": ["direct_text", "text_plain_attachment", "text_markdown_attachment"]
    },
    "filename": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "declared_mime_type": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
