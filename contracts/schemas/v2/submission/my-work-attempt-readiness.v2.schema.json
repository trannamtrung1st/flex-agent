{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/submission/my-work-attempt-readiness.v2.schema.json",
  "title": "My work Attempt readiness v2",
  "description": "Authoritative participant-visible Attempt readiness, entitlement, notice set, and start command digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enrollment_id",
    "readiness_state",
    "next_ordinal",
    "remaining_entitlement",
    "entitlement_source",
    "baseline_attempt_limit",
    "start_command_digest",
    "bound_version_candidates",
    "history",
    "required_notices",
    "permitted_actions"
  ],
  "properties": {
    "schema_version": { "const": "v2" },
    "enrollment_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "eligible",
        "too_early",
        "expired",
        "exhausted",
        "missing_accepted_material",
        "material_not_agent_readable",
        "active_conflict",
        "configuration_unavailable",
        "enrollment_unavailable",
        "dependency_unavailable"
      ]
    },
    "next_ordinal": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "remaining_entitlement": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "entitlement_source": { "type": "string", "enum": ["baseline", "retry"] },
    "baseline_attempt_limit": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "active_attempt_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "active_session_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "start_command_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_version_candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version_id", "version_number", "accepted_at_utc", "item_count"],
        "properties": {
          "version_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "version_number": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "accepted_at_utc": {
            "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
          },
          "item_count": { "type": "integer", "minimum": 0, "maximum": 11 }
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "ordinal", "status", "consumed", "started_at_utc"],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "status": { "type": "string", "enum": ["active", "completed", "aborted"] },
          "consumed": { "type": "boolean" },
          "session_id": {
            "type": ["string", "null"],
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "started_at_utc": {
            "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
          },
          "terminal_at_utc": {
            "type": ["string", "null"],
            "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
          },
          "terminal_reason_category": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "required_notices": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notice_id",
          "notice_type",
          "required_outcome",
          "protected_content_ref",
          "source_version_id",
          "content_digest",
          "source_id"
        ],
        "properties": {
          "notice_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "notice_type": { "type": "string", "enum": ["instructions", "consent", "data_use"] },
          "required_outcome": { "type": "string", "enum": ["affirmed"] },
          "protected_content_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source_version_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "content_digest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "permitted_actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": ["start_attempt", "continue_attempt", "return_to_my_work"]
      }
    }
  }
}
