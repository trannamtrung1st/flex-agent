{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v2/submission/begin-intake-command.v2.schema.json",
  "title": "Begin intake command v2",
  "description": "Participant command that opens a durable Submission intake for the current Enrollment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key"],
  "properties": {
    "schema_version": { "const": "v2" },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
