{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/session/trusted-trigger.v1.schema.json",
  "title": "Trusted trigger v1",
  "description": "Typed trusted trigger admitted by the Session runtime before Invocation allocation. Provenance is server-derived only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_family",
    "trigger_type",
    "trigger_id",
    "idempotency_key",
    "ownership",
    "purpose"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
    },
    "trigger_family": {
      "type": "string",
      "enum": [
        "participant_input",
        "interaction_signal",
        "workflow_event",
        "timer_event",
        "tool_result",
        "system_event"
      ]
    },
    "trigger_type": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{7,127}$"
    },
    "trigger_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "ownership": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/session_ownership_ref"
    },
    "purpose": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "turn_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "response_slot_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "provenance_ref": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
    }
  }
}
