{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/session/agent-invocation-execution-outcome.v1.schema.json",
  "title": "Agent Invocation execution outcome v1",
  "description": "Invocation-level terminal execution outcome when no Agent Decision is produced.",
  "oneOf": [
    { "$ref": "#/$defs/execution_failed_outcome" },
    { "$ref": "#/$defs/cancelled_outcome" },
    { "$ref": "#/$defs/late_result_outcome" },
    { "$ref": "#/$defs/pre_execution_rejected_outcome" },
    { "$ref": "#/$defs/attempts_exhausted_outcome" }
  ],
  "$defs": {
    "execution_failed_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_outcome_id",
        "agent_invocation_id",
        "outcome_category",
        "reason_category",
        "terminal_at",
        "last_execution_attempt_id"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_outcome_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "outcome_category": { "const": "execution_failed" },
        "reason_category": {
          "type": "string",
          "enum": [
            "provider_timeout",
            "provider_unavailable",
            "malformed_control",
            "incomplete_control"
          ]
        },
        "terminal_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "last_execution_attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "cancelled_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_outcome_id",
        "agent_invocation_id",
        "outcome_category",
        "reason_category",
        "terminal_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_outcome_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "outcome_category": { "const": "cancelled" },
        "reason_category": {
          "type": "string",
          "enum": ["lifecycle_cancelled", "cutoff_exceeded"]
        },
        "terminal_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "last_execution_attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "late_result_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_outcome_id",
        "agent_invocation_id",
        "outcome_category",
        "reason_category",
        "terminal_at",
        "last_execution_attempt_id"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_outcome_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "outcome_category": { "const": "late_result" },
        "reason_category": { "const": "late_provider_result" },
        "terminal_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "last_execution_attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "pre_execution_rejected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_outcome_id",
        "agent_invocation_id",
        "outcome_category",
        "reason_category",
        "terminal_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_outcome_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "outcome_category": { "const": "pre_execution_rejected" },
        "reason_category": {
          "type": "string",
          "enum": [
            "state_ineligible",
            "authorization_revoked",
            "policy_prohibited",
            "budget_exhausted"
          ]
        },
        "terminal_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        }
      }
    },
    "attempts_exhausted_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_outcome_id",
        "agent_invocation_id",
        "outcome_category",
        "reason_category",
        "terminal_at",
        "last_execution_attempt_id"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_outcome_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "outcome_category": { "const": "attempts_exhausted" },
        "reason_category": { "const": "retry_budget_exhausted" },
        "terminal_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "last_execution_attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    }
  }
}
