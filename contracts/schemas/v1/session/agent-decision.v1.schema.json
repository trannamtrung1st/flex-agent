{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/session/agent-decision.v1.schema.json",
  "title": "Agent Decision v1",
  "description": "Structured Agent Decision produced by a successful Invocation. Each branch permits exactly one primary behavior.",
  "oneOf": [
    { "$ref": "#/$defs/emit_message_decision" },
    { "$ref": "#/$defs/no_action_decision" },
    { "$ref": "#/$defs/deferred_decision" }
  ],
  "$defs": {
    "emit_message_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["communication_purpose"],
      "properties": {
        "communication_purpose": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        },
        "turn_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "response_slot_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "no_action_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_category"],
      "properties": {
        "reason_category": {
          "type": "string",
          "enum": [
            "intentional_silence",
            "workflow_complete",
            "awaiting_input"
          ]
        }
      }
    },
    "next_timer_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_delay", "expected_schedule_revision"],
      "properties": {
        "relative_delay": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/iso8601_positive_duration"
        },
        "expected_schedule_revision": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/positive_int64_wire_string"
        }
      }
    },
    "emit_message_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_decision_id",
        "agent_invocation_id",
        "decision_type",
        "produced_at",
        "emit_message"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "agent_decision_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "decision_type": { "const": "emit_message" },
        "produced_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "emit_message": { "$ref": "#/$defs/emit_message_payload" },
        "next_timer_request": { "$ref": "#/$defs/next_timer_request" },
        "payload_ref": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
        }
      }
    },
    "no_action_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_decision_id",
        "agent_invocation_id",
        "decision_type",
        "produced_at",
        "no_action"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "agent_decision_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "decision_type": { "const": "no_action" },
        "produced_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "no_action": { "$ref": "#/$defs/no_action_payload" },
        "next_timer_request": { "$ref": "#/$defs/next_timer_request" },
        "payload_ref": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
        }
      }
    },
    "deferred_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_decision_id",
        "agent_invocation_id",
        "decision_type",
        "produced_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "agent_decision_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "decision_type": {
          "type": "string",
          "enum": ["request_tool", "propose_transition", "escalate"]
        },
        "produced_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "next_timer_request": { "$ref": "#/$defs/next_timer_request" },
        "payload_ref": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
        }
      }
    }
  }
}
