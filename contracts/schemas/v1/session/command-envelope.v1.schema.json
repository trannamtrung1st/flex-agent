{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/session/command-envelope.v1.schema.json",
  "title": "Session command envelope v1",
  "description": "Discriminated session command envelope per session-runtime-contract.",
  "oneOf": [
    { "$ref": "#/$defs/message_send_command" },
    { "$ref": "#/$defs/pause_command" },
    { "$ref": "#/$defs/resume_command" },
    { "$ref": "#/$defs/complete_command" },
    { "$ref": "#/$defs/terminate_command" },
    { "$ref": "#/$defs/reconcile_command" }
  ],
  "$defs": {
    "command_envelope_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_type",
        "command_id",
        "idempotency_key",
        "session_locator",
        "expected_session_version",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "command_type": {
          "type": "string"
        },
        "command_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/correlation_id"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "session_locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id"],
          "properties": {
            "session_id": {
              "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
            }
          }
        },
        "expected_session_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "client_last_seen_sequence": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/positive_int64_wire_string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "message_send_command": {
      "allOf": [
        { "$ref": "#/$defs/command_envelope_core" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "session.message.send.v1" },
            "payload": { "$ref": "#/$defs/message_send_payload" }
          }
        }
      ]
    },
    "pause_command": {
      "allOf": [
        { "$ref": "#/$defs/command_envelope_core" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "session.pause.v1" },
            "payload": { "$ref": "#/$defs/empty_payload" }
          }
        }
      ]
    },
    "resume_command": {
      "allOf": [
        { "$ref": "#/$defs/command_envelope_core" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "session.resume.v1" },
            "payload": { "$ref": "#/$defs/empty_payload" }
          }
        }
      ]
    },
    "complete_command": {
      "allOf": [
        { "$ref": "#/$defs/command_envelope_core" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "session.complete.v1" },
            "payload": { "$ref": "#/$defs/empty_payload" }
          }
        }
      ]
    },
    "terminate_command": {
      "allOf": [
        { "$ref": "#/$defs/command_envelope_core" },
        {
          "type": "object",
          "properties": {
            "command_type": { "const": "session.terminate.v1" },
            "payload": { "$ref": "#/$defs/terminate_payload" }
          }
        }
      ]
    },
    "reconcile_command": {
      "allOf": [
        { "$ref": "#/$defs/command_envelope_core" },
        {
          "type": "object",
          "required": ["client_last_seen_sequence"],
          "properties": {
            "command_type": { "const": "session.reconcile.v1" },
            "payload": { "$ref": "#/$defs/empty_payload" }
          }
        }
      ]
    },
    "empty_payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "message_send_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_text"],
      "properties": {
        "message_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "terminate_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code"],
      "properties": {
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
