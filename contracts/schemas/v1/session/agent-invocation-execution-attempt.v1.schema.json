{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/session/agent-invocation-execution-attempt.v1.schema.json",
  "title": "Agent Invocation execution attempt v1",
  "description": "Bounded provider-neutral execution attempt for one Agent Invocation. Distinct from generation_attempt_id used for fragment publication.",
  "oneOf": [
    { "$ref": "#/$defs/decision_produced_attempt" },
    { "$ref": "#/$defs/failed_attempt" }
  ],
  "$defs": {
    "decision_produced_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_attempt_id",
        "agent_invocation_id",
        "attempt_ordinal",
        "outcome_category",
        "started_at",
        "completed_at",
        "agent_decision_id"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "outcome_category": { "const": "decision_produced" },
        "started_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "completed_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "provider_request_ref": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
        },
        "agent_decision_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "failed_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_attempt_id",
        "agent_invocation_id",
        "attempt_ordinal",
        "outcome_category",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
        },
        "execution_attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "agent_invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "outcome_category": {
          "type": "string",
          "enum": [
            "provider_timeout",
            "provider_unavailable",
            "malformed_control",
            "incomplete_control",
            "cancelled",
            "late_result"
          ]
        },
        "started_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "completed_at": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
        },
        "provider_request_ref": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
        }
      }
    }
  }
}
