{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/evaluation/evaluation-annotation.v1.schema.json",
  "title": "Evaluation annotation v1",
  "description": "Append-only integrity, availability, or lifecycle annotation. Does not mutate historical completion state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "evaluation_id",
    "kind",
    "disposition",
    "reason",
    "actor_type",
    "actor_id",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
    },
    "annotation_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "evaluation_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "evidence_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "source_integrity_changed",
        "source_lawfully_unavailable",
        "lower_precision_recorded",
        "lifecycle_hold",
        "lifecycle_expiry"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "attention_required",
        "lawfully_unavailable",
        "lower_precision",
        "held",
        "expired_minimum_provenance"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{7,127}$"
    },
    "actor_type": {
      "type": "string",
      "enum": ["human", "service", "system"]
    },
    "actor_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "occurred_at": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
    }
  }
}
