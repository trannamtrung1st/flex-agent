{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/evaluation/evaluation-model-response.v1.schema.json",
  "title": "Evaluation model response v1",
  "description": "Internal bounded model judgment envelope validated before completion. Response body stays in a protected reference; inline fields exclude hidden reasoning and credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output_schema_id",
    "criterion_id",
    "criterion_version",
    "evaluator_mode",
    "status",
    "confidence",
    "uncertainty",
    "rationale",
    "evidence_ids",
    "response_ref"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
    },
    "output_schema_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{7,127}$"
    },
    "criterion_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "criterion_version": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "evaluator_mode": {
      "type": "string",
      "enum": ["agent_assisted", "agent_judgment"]
    },
    "status": {
      "type": "string",
      "enum": [
        "satisfied",
        "not_satisfied",
        "insufficient_evidence",
        "not_applicable",
        "conflict"
      ]
    },
    "score": {
      "oneOf": [
        { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        { "type": "string", "minLength": 1, "maxLength": 64 },
        { "type": "null" }
      ]
    },
    "confidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "uncertainty": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "provisional_feedback": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 2000 },
        { "type": "null" }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
      }
    },
    "deterministic_invocation_id": {
      "oneOf": [
        {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        { "type": "null" }
      ]
    },
    "response_ref": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/protected_reference"
    }
  }
}
