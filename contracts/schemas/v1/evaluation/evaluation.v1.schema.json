{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/evaluation/evaluation.v1.schema.json",
  "title": "Evaluation v1",
  "description": "Immutable completed Evaluation artifact. Not a Result, Review decision, or Release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "request_id",
    "ownership",
    "procedure_ref",
    "configuration_digest",
    "manifest_digest",
    "manifest_seal_procedure_id",
    "evidence_set_id",
    "evidence_set_digest",
    "criterion_ids",
    "aggregate_status",
    "completed_at",
    "creation_service_id"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
    },
    "evaluation_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "request_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "ownership": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/session_ownership_ref"
    },
    "procedure_ref": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/source_reference"
    },
    "configuration_digest": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
    },
    "manifest_digest": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
    },
    "manifest_seal_procedure_id": {
      "type": "string",
      "enum": ["manifest-jcs-sha256-v1", "manifest-jcs-sha256-v2"]
    },
    "evidence_set_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "evidence_set_digest": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
    },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
      }
    },
    "aggregate_status": {
      "type": "string",
      "enum": [
        "complete",
        "insufficient_evidence",
        "conflict_review_required",
        "not_applicable_excluded"
      ]
    },
    "completed_at": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
    },
    "creation_service_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "predecessor_evaluation_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    }
  }
}
