{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/digest/manifest-seal-document.v1.schema.json",
  "title": "Manifest terminal seal document v1",
  "description": "Normalization target for manifest-jcs-sha256-v1 per ADR-001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "procedure_id",
    "schema_version",
    "canonicalization_version",
    "manifest_schema_version",
    "configuration_ref",
    "runtime_records",
    "terminal_state",
    "terminal_reason",
    "ownership"
  ],
  "properties": {
    "procedure_id": {
      "type": "string",
      "const": "manifest-jcs-sha256-v1"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "canonicalization_version": {
      "type": "string",
      "const": "rfc8785"
    },
    "manifest_schema_version": {
      "type": "string",
      "const": "v1"
    },
    "configuration_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "configuration_digest"],
      "properties": {
        "configuration_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "configuration_digest": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
        }
      }
    },
    "runtime_records": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/sealed_runtime_record" }
    },
    "terminal_state": {
      "type": "string",
      "enum": ["completed", "terminated", "aborted"]
    },
    "terminal_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ownership": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/session_ownership_ref"
    }
  },
  "$defs": {
    "sealed_runtime_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "record_type", "payload_digest"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "record_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "payload_digest": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
        }
      }
    }
  }
}
