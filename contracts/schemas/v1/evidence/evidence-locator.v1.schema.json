{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/evidence/evidence-locator.v1.schema.json",
  "title": "Evidence locator v1",
  "description": "Tagged evidence-locator.v1 union per evaluation-execution-contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locator_schema",
    "source_type",
    "source_ref",
    "ownership_ref",
    "location",
    "precision",
    "integrity",
    "created_by"
  ],
  "properties": {
    "locator_schema": {
      "type": "string",
      "const": "evidence-locator.v1"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "submission.direct_text",
        "submission.text_attachment",
        "session.transcript_item",
        "session.work_trace",
        "configuration.fact",
        "manifest.fact",
        "deterministic.fact"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version"],
      "properties": {
        "source_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "source_version": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "terminal_cutoff_sequence": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/positive_int64_wire_string"
        }
      }
    },
    "ownership_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "activity_id",
        "participant_id",
        "attempt_id",
        "session_id",
        "evaluation_id"
      ],
      "properties": {
        "organization_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "activity_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "participant_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "attempt_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "session_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "evaluation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "location": {
      "oneOf": [
        { "$ref": "#/$defs/whole_item_location" },
        { "$ref": "#/$defs/line_range_location" },
        { "$ref": "#/$defs/byte_range_location" },
        { "$ref": "#/$defs/json_pointer_location" }
      ]
    },
    "precision": {
      "type": "string",
      "enum": ["exact_range", "stable_segment", "whole_item"]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_digest",
        "adapter_version",
        "verification_state"
      ],
      "properties": {
        "source_digest": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verification_state": {
          "type": "string",
          "enum": ["verified", "degraded", "failed"]
        }
      }
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "invocation_id"],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "invocation_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_type": {
            "enum": ["submission.direct_text", "submission.text_attachment"]
          }
        },
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "location": {
            "oneOf": [
              { "$ref": "#/$defs/whole_item_location" },
              { "$ref": "#/$defs/line_range_location" },
              { "$ref": "#/$defs/byte_range_location" }
            ]
          },
          "precision": {
            "enum": ["exact_range", "whole_item"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "enum": ["session.transcript_item", "session.work_trace"]
          }
        },
        "required": ["source_type"]
      },
      "then": {
        "required": ["source_ref"],
        "properties": {
          "source_ref": {
            "required": ["terminal_cutoff_sequence"]
          },
          "location": {
            "oneOf": [
              { "$ref": "#/$defs/whole_item_location" },
              { "$ref": "#/$defs/byte_range_location" }
            ]
          },
          "precision": {
            "enum": ["exact_range", "whole_item"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_type": {
            "enum": ["configuration.fact", "manifest.fact", "deterministic.fact"]
          }
        },
        "required": ["source_type"]
      },
      "then": {
        "properties": {
          "location": { "$ref": "#/$defs/json_pointer_location" },
          "precision": {
            "enum": ["exact_range", "stable_segment", "whole_item"]
          }
        }
      }
    }
  ],
  "$defs": {
    "whole_item_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_type", "item_id"],
      "properties": {
        "location_type": { "const": "whole_item" },
        "item_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        }
      }
    },
    "line_range_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_type", "item_id", "start_line_inclusive", "end_line_inclusive", "line_split_procedure_version"],
      "properties": {
        "location_type": { "const": "line_range" },
        "item_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "start_line_inclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "end_line_inclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "line_split_procedure_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "byte_range_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_type", "item_id", "start_inclusive", "end_exclusive", "excerpt_digest"],
      "properties": {
        "location_type": { "const": "utf8_byte_range" },
        "item_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "start_inclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "end_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048577
        },
        "excerpt_digest": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/sha256_hex"
        }
      }
    },
    "json_pointer_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_type", "json_pointer"],
      "properties": {
        "location_type": { "const": "json_pointer" },
        "json_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^/"
        }
      }
    }
  }
}
