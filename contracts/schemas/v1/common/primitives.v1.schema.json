{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json",
  "title": "Flex Agent common contract primitives",
  "description": "Shared identifier, timestamp, and reference primitives for versioned contracts.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 0,
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{7,127}$"
    },
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "maxLength": 32
    },
    "int64_wire_string_nineteen_digit": {
      "type": "string",
      "minLength": 19,
      "maxLength": 19,
      "pattern": "^(922337203685477580[0-7]|92233720368547758[0-6][0-9]|9223372036854775[0-7][0-9]{2}|922337203685477[0-4][0-9]{3}|92233720368547[0-5][0-9]{4}|9223372036854[0-6][0-9]{5}|922337203685[0-3][0-9]{6}|92233720368[0-4][0-9]{7}|9223372036[0-7][0-9]{8}|922337203[0-5][0-9]{9}|92233720[0-2][0-9]{10}|9223372[0-0][0-9]{11}|922337[0-1][0-9]{12}|92233[0-6][0-9]{13}|9223[0-2][0-9]{14}|922[0-2][0-9]{15}|92[0-1][0-9]{16}|9[0-1][0-9]{17}|[1-8][0-9]{18})$"
    },
    "nonnegative_int64_wire_string": {
      "oneOf": [
        { "const": "0" },
        { "type": "string", "pattern": "^[1-9]$" },
        { "type": "string", "pattern": "^[1-9][0-9]{1,16}$", "minLength": 2, "maxLength": 17 },
        { "type": "string", "pattern": "^[1-9][0-9]{17}$", "minLength": 18, "maxLength": 18 },
        { "$ref": "#/$defs/int64_wire_string_nineteen_digit" }
      ]
    },
    "positive_int64_wire_string": {
      "oneOf": [
        { "type": "string", "pattern": "^[1-9]$" },
        { "type": "string", "pattern": "^[1-9][0-9]{1,16}$", "minLength": 2, "maxLength": 17 },
        { "type": "string", "pattern": "^[1-9][0-9]{17}$", "minLength": 18, "maxLength": 18 },
        { "$ref": "#/$defs/int64_wire_string_nineteen_digit" }
      ]
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "correlation_id": {
      "$ref": "#/$defs/stable_id"
    },
    "organization_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id"],
      "properties": {
        "organization_id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "session_ownership_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "activity_id",
        "participant_id",
        "attempt_id",
        "session_id"
      ],
      "properties": {
        "organization_id": { "$ref": "#/$defs/stable_id" },
        "activity_id": { "$ref": "#/$defs/stable_id" },
        "participant_id": { "$ref": "#/$defs/stable_id" },
        "attempt_id": { "$ref": "#/$defs/stable_id" },
        "session_id": { "$ref": "#/$defs/stable_id" }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version", "content_digest"],
      "properties": {
        "source_id": { "$ref": "#/$defs/stable_id" },
        "source_version": { "$ref": "#/$defs/stable_id" },
        "content_digest": { "$ref": "#/$defs/sha256_hex" }
      }
    },
    "semantic_string_set": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "iso8601_positive_duration": {
      "type": "string",
      "description": "Positive ISO 8601 duration without year/month/week or fractional seconds. Wire shape is validated here; total active seconds must fall within PT1S..PT24H via semantic contract tests.",
      "minLength": 4,
      "maxLength": 16,
      "oneOf": [
        { "pattern": "^PT(?:[1-9]|[1-5][0-9])S$" },
        { "pattern": "^PT(?:[1-9]|[1-5][0-9])M$" },
        { "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H$" },
        { "pattern": "^PT24H$" },
        { "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H(?:[1-9]|[1-5][0-9])M$" },
        { "pattern": "^PT(?:[1-9]|[1-5][0-9])M(?:[1-9]|[1-5][0-9])S$" },
        { "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H(?:[1-9]|[1-5][0-9])S$" },
        { "pattern": "^PT(?:[1-9]|1[0-9]|2[0-3])H(?:[1-9]|[1-5][0-9])M(?:[1-9]|[1-5][0-9])S$" }
      ]
    },
    "protected_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_ref", "content_digest"],
      "properties": {
        "protected_ref": {
          "$ref": "#/$defs/stable_id"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    }
  }
}
