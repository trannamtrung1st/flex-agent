{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex-agent.local/contracts/schemas/v1/transport/sse-event.v1.schema.json",
  "title": "SSE session event v1",
  "description": "Representative committed SSE projection with cursor semantics and no authorization evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "session_id",
    "session_sequence",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/schema_version"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session.agent.fragment.v1",
        "session.state.changed.v1",
        "session.terminal.v1"
      ]
    },
    "session_id": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
    },
    "session_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "occurred_at": {
      "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/utc_timestamp"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fragment_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "agent_message_id": {
          "$ref": "https://flex-agent.local/contracts/schemas/v1/common/primitives.v1.schema.json#/$defs/stable_id"
        },
        "text_delta": {
          "type": "string",
          "maxLength": 4096
        }
      }
    }
  }
}
